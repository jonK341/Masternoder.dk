# MN2 explorer API cache rules — include inside the server {} block (P4 #173).
# Adjust proxy_pass upstream to match your uwsgi/socket setup.

location = /api/mn2/network-overview {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_cache_valid 200 30s;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    add_header X-Cache-Status $upstream_cache_status always;
}

location ~ ^/api/mn2/(recent-blocks|network-history|explorer/status) {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_cache_valid 200 15s;
}

# Do not cache authenticated or mutating routes; SSE stream must bypass cache:
location = /api/mn2/explorer/stream {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
}
