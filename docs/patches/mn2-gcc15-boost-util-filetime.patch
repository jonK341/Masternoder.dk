+template<typename T>
+typename std::enable_if<std::is_integral<T>::value, std::time_t>::type
+BoostFilesystemLastWriteTimeImpl(T t)
+{
+    return static_cast<std::time_t>(t);
+}
+
+template<typename T>
+typename std::enable_if<!std::is_integral<T>::value, std::time_t>::type
+BoostFilesystemLastWriteTimeImpl(T ft)
+{
+    using namespace std::chrono;
+    return system_clock::to_time_t(time_point_cast<system_clock::duration>(
+        ft - T::clock::now() + system_clock::now()));
+}
+
+std::time_t BoostFilesystemLastWriteTime(const boost::filesystem::path& path)
+{
+#if BOOST_VERSION < 106600
+    return boost::filesystem::last_write_time(path);
+#else
+    return BoostFilesystemLastWriteTimeImpl(boost::filesystem::last_write_time(path));
+#endif
+}
