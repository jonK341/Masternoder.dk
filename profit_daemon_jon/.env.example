# The Profit Daemon Jon — start in paper mode
DAEMON_QUIET=1
LITE_APP=1
EXCHANGE_PROFIT_PROFILE=standard
EXCHANGE_ARBITRAGE_LIVE=0
EXCHANGE_LIVE_PROFIT_MAX=0
EXCHANGE_DAEMON_MODE=paper
BINANCE_QUOTE=USDC
EXCHANGE_FORCE_IPV4=1
EXCHANGE_METRICS_PORT=9108
EXCHANGE_REDIS_URL=redis://127.0.0.1:6379/0

# Optional venue keys (leave empty for paper / public market data only)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# NONKYC_API_KEY=
# NONKYC_API_SECRET=

# Live unlock (only after keys + funded wallets)
# EXCHANGE_ARBITRAGE_LIVE=1
