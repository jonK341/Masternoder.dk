# The Profit Daemon Jon — start in paper mode
DAEMON_QUIET=1
LITE_APP=1
EXCHANGE_PROFIT_PROFILE=standard
EXCHANGE_ARBITRAGE_LIVE=0
EXCHANGE_LIVE_PROFIT_MAX=0
EXCHANGE_DAEMON_MODE=paper
BINANCE_QUOTE=USDC
EXCHANGE_FORCE_IPV4=1
EXCHANGE_METRICS_PORT=9108
EXCHANGE_REDIS_URL=redis://127.0.0.1:6379/0

# Optional venue keys (leave empty for paper / public market data only).
# Add any {VENUE}_API_KEY / _SECRET from data/exchanges_registry.json credentials_env.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# NONKYC_API_KEY=
# NONKYC_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Local browser control (auto-opens on daemon start)
PROFIT_DAEMON_CONTROL_PORT=8787
# PROFIT_DAEMON_NO_CONTROL=1
# PROFIT_DAEMON_OPEN_BROWSER=0

# Live unlock (only after keys + funded wallets)
# EXCHANGE_ARBITRAGE_LIVE=1
# EXCHANGE_LIVE_PROFIT_MAX=1
# EXCHANGE_DAEMON_MODE=live
