[Unit]
Description=MasterNoder profit daemons (exchange + casino + extended)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/html
Environment=DAEMON_QUIET=1
Environment=LITE_APP=1
Environment=EXCHANGE_DAEMON_MODE=live
Environment=EXCHANGE_PROFIT_PROFILE=max
Environment=PROFIT_DAEMON_HEARTBEAT_PATH=/var/www/html/logs/daemon_all_profit_heartbeat.json
ExecStart=/var/www/html/scripts/run_profit_daemon_server.sh
Restart=always
RestartSec=15
StandardOutput=append:/var/www/html/logs/profit_daemon_stdout.log
StandardError=append:/var/www/html/logs/profit_daemon_stderr.log

[Install]
WantedBy=multi-user.target
