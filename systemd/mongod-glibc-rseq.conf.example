# MongoDB 8.0 on Linux kernel 6.19 through 7.0.13 refuses to start (SERVER-121912).
# Workaround until the host kernel is 7.0.14+ or mongod is upgraded per SERVER-125742:
#   GLIBC_TUNABLES=glibc.pthread.rseq=1
#
# Install:
#   sudo bash scripts/install_mongod_glibc_rseq.sh
#
# Or copy manually:
#   sudo mkdir -p /etc/systemd/system/mongod.service.d
#   sudo cp systemd/mongod-glibc-rseq.conf.example /etc/systemd/system/mongod.service.d/glibc-rseq.conf
#   sudo systemctl daemon-reload && sudo systemctl restart mongod

[Service]
Environment="GLIBC_TUNABLES=glibc.pthread.rseq=1"
