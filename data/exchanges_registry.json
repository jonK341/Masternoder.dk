  "recommended_services": [
    {
      "id": "local_control",
      "title": "Local browser control (127.0.0.1)",
      "why": "Start/stop visibility, add exchanges, paper/live status without exposing a public port",
      "port": 8787,
      "required": true
    },
    {
      "id": "redis_bus",
      "title": "Redis market bus",
      "why": "Shared live mids across ticks; file fallback if down",
      "url_env": "EXCHANGE_REDIS_URL",
      "default": "redis://127.0.0.1:6379/0"
    },
    {
      "id": "prometheus",
      "title": "Prometheus metrics scrape",
      "why": "PnL, fills, skew, feed age for the control + Grafana",
      "port": 9108
    },
    {
      "id": "grafana",
      "title": "Grafana operator dashboards",
      "why": "Visual ladder/health panels",
      "port": 3030,
      "path": "/grafana/"
    },
    {
      "id": "secrets_vault",
      "title": "Encrypted secrets vault",
      "why": "Live API keys never sit in plain .env",
      "env": "EXCHANGE_VAULT_KEY"
    },
    {
      "id": "binance_ws_feed",
      "title": "Binance bookTicker WebSocket",
      "why": "Sub-second mids for ladder pricing",
      "module": "backend.services.exchange_market_feed_service"
    },
    {
      "id": "heartbeat",
      "title": "Daemon heartbeat file",
      "why": "Control panel detects stalled ticks"
    },
    {
      "id": "sales_api",
      "title": "HTTP sales report",
      "why": "3h fill/PnL from control without CLI"
    },
    {
      "id": "docker_compose",
      "title": "Docker Compose stack",
      "why": "One-liner Redis+Prometheus+Grafana+daemon for operators"
    }
  ]
}
